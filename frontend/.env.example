# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Framework: Next.js 14 (App Router)
# ==============================================================================
# NOTE: Do NOT set NODE_ENV here. Next.js manages NODE_ENV automatically:
#       - 'development' during next dev
#       - 'production' during next build & next start
# ==============================================================================

# 1. Public Application URL
# Used for canonical SEO metadata, OpenGraph tags, and public links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Public API URL
# In browser requests, Next.js rewrites '/api/*' to the backend target.
# This variable is used during SSR or as a direct client fallback.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 3. Realtime WebSocket Endpoints
# For local development (connects to ws://localhost:5000/ws)
NEXT_PUBLIC_WS_PORT=5000

# For production / cloud deployments (e.g. Render, Railway, AWS):
# Set this to your backend's public WSS endpoint
# NEXT_PUBLIC_WS_URL=wss://nexus-backend.onrender.com/ws

# 4. Next.js Server-Side Rewrite Proxy (Internal Routing)
# Configured in next.config.mjs to proxy all '/api/:path*' calls directly to Express API.
# On localhost: http://127.0.0.1:5000
# On cloud platforms with separate backend: https://nexus-backend.onrender.com
INTERNAL_API_URL=http://127.0.0.1:5000

# 5. Local Server Port (Optional, default: 3000)
PORT=3000
