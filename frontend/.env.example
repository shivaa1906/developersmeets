# ==============================================================================
# DEVELOPER COMPANY PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Runtimes
NODE_ENV=development
PORT=5000

# Next.js Frontend URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/developer_platform

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Credit Economy Parameters (Configurable by Admin)
CREDIT_PRICE_INR=50
CLAIM_COST_CREDITS=1
DEFAULT_REFUND_PERCENTAGE=100

# Payment Gateway (Razorpay / Stripe)
PAYMENT_KEY_ID=rzp_test_placeholder_key
PAYMENT_SECRET=replace_with_payment_gateway_secret
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# Supabase Integration (Optional Storage / Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
