# ==============================================================================
# DEVELOPER COMPANY PLATFORM - MASTER ENVIRONMENT CONFIGURATION (.env.example)
# Architecture: Monorepo (Next.js 14 App Router + Node.js/Express Backend)
# ==============================================================================
# This file serves as the master reference for local setup and cloud deployments
# (Render, Vercel, Railway, AWS ECS/EC2, or Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ------------------------------------------------------------------------------
# NOTE: Do NOT define NODE_ENV in frontend/.env (Next.js manages it automatically).

# Public URL of the frontend application (for SEO, OpenGraph, Canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client-facing / SSR API endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WebSocket port (local development: ws://localhost:5000/ws)
NEXT_PUBLIC_WS_PORT=5000

# WebSocket full URL (production / custom cloud domain)
# Example: wss://nexus-backend.onrender.com/ws
# NEXT_PUBLIC_WS_URL=

# Next.js Server-Side API Proxy (next.config.mjs rewrites /api/* to this address)
# Local: http://127.0.0.1:5000
# Production: https://your-backend-service.onrender.com
INTERNAL_API_URL=http://127.0.0.1:5000

# Frontend HTTP Port (default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ------------------------------------------------------------------------------

# Environment: 'production' for live deployments, 'development' for local
NODE_ENV=production

# Backend HTTP & WebSocket Port (Render provides this dynamically via $PORT)
PORT=5000

# PostgreSQL Connection String
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_platform

# Authentication Secret (Minimum 64-character random string)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (Comma-separated, no trailing slash)
# Local: http://localhost:3000
# Production: https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:3000

# Platform Economy Rules
CREDIT_PRICE_INR=50
CLAIM_COST_CREDITS=1
DEFAULT_REFUND_PERCENTAGE=100

# Payment Integration (Razorpay / Stripe)
PAYMENT_KEY_ID=rzp_test_placeholder_key
PAYMENT_SECRET=replace_with_payment_gateway_secret
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_secret

# Default Password for Initial Database Seeds (ritesh@nexus.dev & shiva@nexus.dev)
SEED_DEFAULT_PASSWORD=DevPlatform2026!Secure

# Google OAuth 2.0 Credentials (Phase 5)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Facebook OAuth 2.0 Credentials (Phase 6)
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback


